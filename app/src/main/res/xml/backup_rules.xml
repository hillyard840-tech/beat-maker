<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
   Preferences holding API keys and agent credentials are never backed up.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="omni_agent_prefs.xml" />
    <exclude domain="sharedpref" path="moltbook_credentials.xml" />
</full-backup-content>
